.barbarian-root {
    flex-grow: 1;
    justify-content: center;
    padding: 10px;
}

/* 가로 배치 컨테이너 */
.barbarian-row {
    flex-direction: row;
    align-items: center; /* 아이콘과 바의 수직 중앙 정렬 */
    margin-bottom: 15px; /* 두 게이지 사이의 간격 */
}

/* 아이콘 공통 속성 */
.barbarian-icon {
    width: 48px;
    height: 48px;
    background-color: rgb(40, 40, 40); /* 이미지 할당 전 임시 배경색 */
    border-width: 2px;
    border-color: rgb(150, 150, 150);
    -unity-background-scale-mode: scale-to-fit;
}

/* 뇌 세포 전용 아이콘 이미지 할당용 클래스 */
.braincell-icon {
    /* background-image: url('뇌세포_아이콘_경로'); */
}

/* 각성 전용 아이콘 이미지 할당용 클래스 */
.awakening-icon {
    /* background-image: url('각성_아이콘_경로'); */
}

/* 프로그레스 바 속성 */
.barbarian-bar {
    flex-grow: 1; /* 남은 가로 공간을 모두 차지함 */
    height: 24px;
}

/* 이하 유니티 기본 막대 제한 해제 및 색상 설정 (기존과 동일) */
.barbarian-bar .unity-progress-bar__container {
    min-height: 100%;
    max-height: 100%;
    height: 100%;
}

.barbarian-bar .unity-progress-bar__background {
    background-color: rgb(30, 30, 30);
    border-width: 0;
    border-radius: 4px;
    margin: 0;
}

.barbarian-bar .unity-progress-bar__title {
    font-size: 14px;
    -unity-font-style: bold;
    color: white;
}

.braincell-color .unity-progress-bar__progress {
    background-color: rgb(150, 50, 200);
    border-radius: 4px;
    margin: 2px;
}

.awakening-color .unity-progress-bar__progress {
    background-color: rgb(220, 150, 30);
    border-radius: 4px;
    margin: 2px;
}