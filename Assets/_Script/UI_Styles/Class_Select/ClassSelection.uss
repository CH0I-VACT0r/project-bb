.selection-panel {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0.85); /* 뒷배경을 어둡게 처리 */
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    position: absolute; /* HUD 위에 덮어씌워지도록 절대 좌표 사용 */
}

.title-text {
    font-size: 40px;
    color: white;
    -unity-font-style: bold;
    margin-bottom: 30px;
}

.button-container {
    flex-direction: row;
    flex-wrap: wrap; /* 버튼이 많아지면 자동으로 줄바꿈 */
    justify-content: center;
}

/* C# 스크립트에서 동적으로 생성한 버튼에 부여될 스타일 */
.class-button {
    width: 200px;
    height: 60px;
    background-color: rgb(50, 50, 50);
    color: white;
    font-size: 24px;
    -unity-font-style: bold;
    border-width: 2px;
    border-color: rgb(150, 150, 150);
    border-radius: 10px;
    margin: 10px;
    transition: background-color 0.1s ease-out; /* 부드러운 호버 효과 */
}

.class-button:hover {
    background-color: rgb(80, 80, 80);
}

.class-button:active {
    background-color: rgb(30, 30, 30);
}