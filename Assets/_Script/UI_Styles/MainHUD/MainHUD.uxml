<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/_Script/UI_Styles/MainHUD/MainHUD.uss?fileID=7433441132597879392&amp;guid=4e4dd6dd4939e7a48b41606dd8226da0&amp;type=3#MainHUD"/>
    <ui:VisualElement name="hud-root" picking-mode="Ignore" class="hud-root" style="flex-grow: 1; justify-content: flex-end; align-items: flex-end; align-content: flex-end; width: 100%; height: 100%; flex-direction: row;">
        <ui:VisualElement name="hud-bottom-container" style="flex-grow: 1; width: 100%; height: 25%; flex-direction: row; justify-content: center; align-content: flex-end; flex-shrink: 0;">
            <ui:VisualElement name="health-section" class="health-section" style="flex-grow: 0; flex-shrink: 0; justify-content: flex-end; align-items: center;">
                <ui:VisualElement name="shield-container" class="shield-container" style="flex-grow: 0; flex-direction: row; flex-wrap: wrap; flex-shrink: 0; align-items: center; justify-content: flex-start; align-self: auto; align-content: flex-start;">
                    <ui:VisualElement name="shield-icon" class="shield-icon" style="flex-grow: 0; flex-shrink: 0;"/>
                </ui:VisualElement>
                <ui:VisualElement name="hp-orb-container" class="hp-orb-container" style="flex-grow: 0; flex-shrink: 0;">
                    <ui:VisualElement name="hp-orb-fluid" class="hp-orb-fluid" style="flex-grow: 1;">
                        <ui:Label text="100 / 100" name="hp-orb-text" class="hp-orb-text"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="center-section" class="center-section" style="flex-grow: 0; flex-shrink: 0;">
                <ui:VisualElement name="identity-container" class="identity-container" style="flex-grow: 0; width: 100%; height: 80%; flex-shrink: 0;"/>
                <ui:VisualElement name="class-level-container" class="class-level-container" style="flex-grow: 0; flex-direction: row; justify-content: space-between; flex-shrink: 0;">
                    <ui:Label text="Class&#10;" name="Class" class="class-level-text"/>
                    <ui:Label text="LV" name="Level" class="class-level-text"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="skill-section" class="skill-section" style="flex-grow: 0; flex-shrink: 0; justify-content: center;">
                <ui:VisualElement name="skill-container" class="skill-container" style="flex-grow: 0; flex-direction: row; flex-shrink: 0;">
                    <ui:VisualElement name="skill-1" class="skill-slot" style="flex-grow: 0; flex-shrink: 0;">
                        <ui:Label text="Q" name="Q" class="skill-hotkey" style="position: absolute; right: 0; bottom: 0;"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="skill-2" class="skill-slot" style="flex-grow: 0; flex-shrink: 0;">
                        <ui:Label text="E" name="E" class="skill-hotkey" style="position: absolute; right: 0; bottom: 0;"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="skill-3" class="skill-slot" style="flex-grow: 0; flex-shrink: 0;">
                        <ui:Label text="R" name="R" class="skill-hotkey" style="position: absolute; right: 0; bottom: 0;"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
